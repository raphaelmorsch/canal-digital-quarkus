# Variáveis de ambiente — copie para o Secret ou configure no Knative Service (S2I + Serverless)
# No console: Serverless → seu Service → Environment → Add environment variable

QUARKUS_PROFILE=prod
DB_HOST=nome-do-service-sqlserver
DB_PORT=1433
DB_NAME=canal_digital
DB_USERNAME=sa
DB_PASSWORD=coloque-a-senha-aqui
DB_ENCRYPT=true
DB_TRUST_CERT=true
DB_LOG_SQL=false
CANAL_DEMO_SEED_ENABLED=true
CANAL_DB_BOOTSTRAP=true
CANAL_FEATURE_SIMULADOR_ECONOMIA=false
# Alternativa equivalente (mapeamento nativo Quarkus):
# CANAL_FEATURE_SIMULADOR_ECONOMIA_ENABLED=true

# Opcional — URL JDBC completa (sobrescreve DB_HOST/PORT/NAME):
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:sqlserver://nome-do-service:1433;databaseName=canal_digital;encrypt=true;trustServerCertificate=true

# Alternativa nativa Quarkus (mesmo efeito das DB_* acima):
# QUARKUS_DATASOURCE_USERNAME=sa
# QUARKUS_DATASOURCE_PASSWORD=coloque-a-senha-aqui
